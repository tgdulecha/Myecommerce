<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.course</groupId>
        <artifactId>myecommerce-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ecommerce-app</artifactId>
    <packaging>jar</packaging>
    <name>ecommerce-app</name>
    <description>Assembles the domain modules into one runnable Spring Boot application (SpringApplication.run + application.properties).</description>

    <dependencies>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-category</artifactId>
        </dependency>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-employee</artifactId>
        </dependency>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-order</artifactId>
        </dependency>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-product</artifactId>
        </dependency>
        <dependency>
            <groupId>org.course</groupId>
            <artifactId>ecommerce-orderdetails</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.course.ecommerce.EcommerceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
