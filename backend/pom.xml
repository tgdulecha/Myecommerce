<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>org.course</groupId>
    <artifactId>myecommerce-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>myecommerce-parent</name>
    <description>Multi-module Spring Boot replica of the Northwind ecommerce REST API, split into one module per domain (Category, Employee, Order, OrderDetails, Product) plus a shared common module and an app module that assembles the runnable jar.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>ecommerce-common</module>
        <module>ecommerce-category</module>
        <module>ecommerce-employee</module>
        <module>ecommerce-order</module>
        <module>ecommerce-product</module>
        <module>ecommerce-orderdetails</module>
        <module>ecommerce-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-category</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-employee</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.course</groupId>
                <artifactId>ecommerce-orderdetails</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
